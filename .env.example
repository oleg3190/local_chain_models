# Global settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8981
GLOBAL_OUTBOUND_PROXY=http://127.0.0.1:2080

# Gemini
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-3.6-flash
GEMINI_USE_PROXY=true
GEMINI_RPM_LIMIT=5
# true = requests carrying tools/tool_calls skip Gemini and go to the fallback chain
GEMINI_TOOLS_BYPASS=false
ENABLE_GEMINI=true

# Where captured Gemini thought signatures are persisted so that a proxy
# restart does not lose them (append-only JSONL, TTL 6h).
# "off" or empty keeps them in memory only.
THOUGHT_SIG_CACHE_PATH=~/.cache/llm-router/thought_signatures.jsonl

# OpenRouter
OPENROUTER_API_KEY=changeme
OPENROUTER_MODEL=openrouter/free
OPENROUTER_USE_PROXY=false
ENABLE_OPENROUTER=true

# DeepSeek (fallback)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_USE_PROXY=false
ENABLE_DEEPSEEK=true
ENABLE_DEEPSEEK_FALLBACK=true

# Cloudflare Workers AI
CLOUDFLARE_API_KEY=sk-your-cloudflare-api-key
CLOUDFLARE_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct
CLOUDFLARE_USE_PROXY=false
ENABLE_CLOUDFLARE=true

# AGY backend (disabled by default)
ENABLE_AGY=false
AGY_AS_FALLBACK=false
AGY_MODEL_ID=agy
# Optional actual model name passed to `agy --model`. Leave empty to use AGY default.
AGY_REMOTE_MODEL=
AGY_AGENT=agy-llm
AGY_EFFORT=high
AGY_PATH=agy
AGY_SSH_BINARY=ssh
# Host alias from ~/.ssh/config. NekoRay/Hysteria can be used there via ProxyCommand.
AGY_SSH_HOST=agy-server
AGY_SSH_ARGS_JSON=["-T","-o","BatchMode=yes","-o","RequestTTY=no"]
AGY_REMOTE_CWD=.
AGY_TIMEOUT_SECONDS=600
# Send SSE comments while AGY is thinking so Pi/proxies keep the connection alive.
AGY_STREAM_HEARTBEAT_SECONDS=15
# The default allows only the harmless terminal "finish" capability if AGY exposes it.
AGY_ALLOWED_INIT_TOOLS=finish
# Keep false: require AGY to return the structured JSON contract.
AGY_ALLOW_TEXT_FALLBACK=false
